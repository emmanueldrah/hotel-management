# ==========================================================================
# HMS - Hotel Management System :: Environment Variables
# Copy to .env and adjust for your environment.
# ==========================================================================

# ----- Database -----
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms_password
POSTGRES_DB=hms
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Used by Prisma / backend. When running backend outside docker use localhost.
DATABASE_URL=postgresql://hms:hms_password@db:5432/hms?schema=public

# ----- Backend -----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ----- Storage (S3 compatible / local) -----
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=hms-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ----- Email (notifications) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@hms.local

# ----- Payments (online booking engine) -----
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ----- Frontend (Vite) -----
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000
